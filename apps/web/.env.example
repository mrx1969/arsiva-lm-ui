FIREBASE_PROJECT_ID=your-google-cloud-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your-identity-platform-web-api-key

AUTH_USERNAME_DOMAIN=users.arsiva.internal
SESSION_COOKIE_NAME=arsiva_session
SESSION_MAX_AGE_SECONDS=28800

APPS_SCRIPT_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SHARED_SECRET=generate-a-long-random-secret

# Hanya dipakai sekali oleh npm run bootstrap:admin.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=Ganti-Dengan-Password-Kuat-123!
BOOTSTRAP_ADMIN_NAME=Super Admin
